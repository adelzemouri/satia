# Copier en .env.local pour `pnpm dev`, ou utiliser `docker compose up`.

# PostgreSQL (Neon en production : utiliser l'URL « pooled »)
DATABASE_URL=postgres://pommelia:pommelia@localhost:5432/pommelia

# Stockage objet compatible S3 (Cloudflare R2 en production, RustFS en local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=pommelia-photos
S3_ACCESS_KEY_ID=pommelia
S3_SECRET_ACCESS_KEY=pommelia-secret
# true en local, false pour R2
S3_FORCE_PATH_STYLE=true

# Authentification : `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# Jeton demandé sur /setup pour créer le compte admin (inutile ensuite)
SETUP_TOKEN=local-setup-token-1234
# Secret des tâches planifiées (purge quotidienne des photos de repas, 16 caractères minimum).
# Sur Vercel, le cron l'envoie tout seul ; ailleurs : GET /api/cron/purge-photos avec
# l'en-tête « Authorization: Bearer <secret> », une fois par jour.
# CRON_SECRET=

# Notifications Web Push : paire de clés générée depuis Admin > Notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:toi@example.com

# Domaines personnalisés autorisés, séparés par des virgules (les *.vercel.app le sont déjà)
# APP_HOSTS=pommelia.example.org

# Tests e2e uniquement : URL d'un Open Food Facts simulé (laisser vide en production)
# OFF_BASE_URL=http://localhost:3199
# OFF_SEARCH_URL=http://localhost:3199

# IA (facultatif : sans clé, les fonctions IA sont simplement désactivées)
# API compatible OpenAI (OpenRouter, Gemini, Mistral, DeepSeek, Ollama…) ou Anthropic
# LLM_PROVIDER=openai            # openai | anthropic | mock (tests) ; openai par défaut si une clé est fournie
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL_VISION=              # modèle photo, le moins cher qui fait le travail
# LLM_MODEL_TEXT=                # modèle texte (saisie libre, coach)
# LLM_MODEL_IMAGE=               # modèle d'images (photos des recettes du foyer), ex. imagen-4.0-fast-generate-001 ; vide = pas de photo générée
# LLM_PRICE_IMAGE=0.04           # dollars par image générée
# LLM_JSON_MODE=json_schema      # json_object pour les fournisseurs sans schéma JSON (DeepSeek…)
# LLM_REASONING_EFFORT=low       # modèles qui réfléchissent (Gemini 3…) : low limite coût et latence
# Tarifs en dollars par million de tokens, pour estimer les coûts et faire respecter le plafond
# LLM_PRICE_VISION_INPUT=0.10
# LLM_PRICE_VISION_OUTPUT=0.40
# LLM_PRICE_TEXT_INPUT=0.10
# LLM_PRICE_TEXT_OUTPUT=0.40
# Plafond mensuel par défaut en dollars (modifiable dans Administration > IA)
# LLM_MONTHLY_BUDGET_USD=2
