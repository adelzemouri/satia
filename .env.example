# Copier en .env.local pour `pnpm dev`, ou utiliser `docker compose up`.

# PostgreSQL (Neon en production : utiliser l'URL « pooled »)
DATABASE_URL=postgres://satia:satia@localhost:5432/satia

# Stockage objet compatible S3 (Cloudflare R2 en production, RustFS en local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=satia-photos
S3_ACCESS_KEY_ID=satia
S3_SECRET_ACCESS_KEY=satia-secret
# true en local, false pour R2
S3_FORCE_PATH_STYLE=true

# Authentification : `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# Jeton demandé sur /setup pour créer le compte admin (inutile ensuite)
SETUP_TOKEN=local-setup-token-1234
# Domaines personnalisés autorisés, séparés par des virgules (les *.vercel.app le sont déjà)
# APP_HOSTS=satia.example.org

# Tests e2e uniquement : URL d'un Open Food Facts simulé (laisser vide en production)
# OFF_BASE_URL=http://localhost:3199
# OFF_SEARCH_URL=http://localhost:3199
